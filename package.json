{
  "name": "runjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "security:scan": "./scripts/security-scan.sh",
    "security:audit": "npm audit --audit-level=moderate",
    "security:trivy": "trivy fs --config trivy.yaml .",
    "security:secrets": "trivy fs --scanners secret .",
    "security:docker": "docker build -f Dockerfile.security -t runjs:scan . && trivy image runjs:scan",
    "security:fix": "npm audit fix",
    "precommit": "npm run lint && npm run test && npm run security:audit",
    "wasm:setup": "npm run wasm:install-wasmtime",
    "wasm:install-wasmtime": "curl -sSf https://wasmtime.dev/install.sh | bash",
    "wasm:test": "node scripts/test-wasm.js",
    "wasm:benchmark": "node scripts/benchmark-wasm.js"
  },
  "dependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.31",
    "next": "14.2.31",
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^5"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "optionalDependencies": {
    "@wasmtime/wasmtime": "^14.0.0"
  }
}